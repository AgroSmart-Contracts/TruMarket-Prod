# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth0 + Web3Auth (wallet identity)
NEXT_PUBLIC_AUTH0_API_URL=https://your-tenant.eu.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_CLIENT_ID_SOCIAL=
NEXT_PUBLIC_AUTH0_CLIENT_SECRET=
NEXT_PUBLIC_AUTH0_BASE_URL=your-tenant.eu.auth0.com
NEXT_PUBLIC_WEB3AUTH_CONNECTION_ID=your-web3auth-verifier
NEXT_PUBLIC_WEB3_AUTH_CLIENT_ID=

# --- Wallet chain (Web3Auth / user identity) — e.g. Sepolia ---
NEXT_PUBLIC_BLOCKCHAIN_CHAIN_ID=0xAA36A7
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_BLOCKCHAIN_NAME=Sepolia
NEXT_PUBLIC_BLOCKCHAIN_EXPLORER=https://sepolia.etherscan.io/
NEXT_PUBLIC_BLOCKCHAIN_TICKER=ETH
NEXT_PUBLIC_BLOCKCHAIN_TICKER_NAME=Ethereum
NEXT_PUBLIC_INVESTMENT_TOKEN_CONTRACT_ADDRESS=0xYourSepoliaUsdcToken
NEXT_PUBLIC_INVESTMENT_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_INVESTMENT_TOKEN_DECIMALS=6

# --- Deal chain (DealsManager / DealVault / on-chain repay) — Arc mainnet ---
NEXT_PUBLIC_DEAL_CHAIN_ID=5042
NEXT_PUBLIC_DEAL_CHAIN_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_DEAL_CHAIN_NAME=Arc
NEXT_PUBLIC_DEAL_CHAIN_EXPLORER=https://explorer.arc.io
NEXT_PUBLIC_DEAL_CHAIN_TICKER=USDC
NEXT_PUBLIC_DEAL_CHAIN_TICKER_NAME=USDC
NEXT_PUBLIC_DEAL_NFT_CONTRACT_ADDRESS=0x0F1a18BE854e9924158474fB6828287eAB10F6F6
NEXT_PUBLIC_DEAL_INVESTMENT_TOKEN_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_DEAL_INVESTMENT_TOKEN_SYMBOL=USDC
NEXT_PUBLIC_DEAL_INVESTMENT_TOKEN_DECIMALS=6

