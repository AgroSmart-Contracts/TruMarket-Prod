# --- Deal chain (mint DealVault, setDealCompleted) — Arc testnet ---
DEAL_CHAIN_RPC_URL=https://rpc.testnet.arc.network
DEAL_CHAIN_ID=5042002
DEAL_CHAIN_EXPLORER=https://testnet.arcscan.app
DEALS_MANAGER_CONTRACT_ADDRESS=0xYourArcDealsManager
INVESTMENT_TOKEN_CONTRACT_ADDRESS=0xYourArcUsdcToken
INVESTMENT_TOKEN_SYMBOL=USDC
INVESTMENT_TOKEN_DECIMALS=6
BLOCKCHAIN_PRIVATE_KEY=0xYourDealsManagerOwnerKey

# CCTP / bridge destination (should match deal chain)
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_USDC_ADDRESS=0xYourArcUsdcToken

AUTOMATIC_DEALS_ACCEPTANCE=true

# Legacy fallbacks (optional — DEAL_CHAIN_* takes precedence)
# BLOCKCHAIN_RPC_URL=
# BLOCKCHAIN_CHAIN_ID=
# BLOCKCHAIN_EXPLORER=
