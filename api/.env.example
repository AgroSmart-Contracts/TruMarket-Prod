# --- Deal chain (mint DealVault, setDealCompleted) — Arc mainnet (Circle grant M2) ---
DEAL_CHAIN_RPC_URL=https://rpc.mainnet.arc.io
DEAL_CHAIN_ID=5042
DEAL_CHAIN_EXPLORER=https://explorer.arc.io
DEALS_MANAGER_CONTRACT_ADDRESS=0x0F1a18BE854e9924158474fB6828287eAB10F6F6
INVESTMENT_TOKEN_CONTRACT_ADDRESS=0x3600000000000000000000000000000000000000
INVESTMENT_TOKEN_SYMBOL=USDC
INVESTMENT_TOKEN_DECIMALS=6
# Must be DealsManager owner (deployer): 0x916d9dF94a82B63aa95761A9C017fAD46492FEC8
BLOCKCHAIN_PRIVATE_KEY=0xYourDealsManagerOwnerKey

# CCTP / bridge destination (Arc)
ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_EXPLORER_URL=https://explorer.arc.io
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

AUTOMATIC_DEALS_ACCEPTANCE=true

# Legacy fallbacks (optional — DEAL_CHAIN_* takes precedence)
# BLOCKCHAIN_RPC_URL=https://rpc.mainnet.arc.io
# BLOCKCHAIN_CHAIN_ID=5042
# BLOCKCHAIN_EXPLORER=https://explorer.arc.io

