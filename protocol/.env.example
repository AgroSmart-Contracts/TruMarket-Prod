# Deployer wallet (must hold Arc USDC for gas)
PRIVATE_KEY=
# or use the same key name as the API:
# BLOCKCHAIN_PRIVATE_KEY=

# --- Arc Testnet ---
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://explorer.testnet.arc.io
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# --- Arc Mainnet (Circle grant M2) ---
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_CHAIN_ID=5042
ARC_MAINNET_EXPLORER_URL=https://explorer.arc.io
# USDC ERC-20 interface is the same address on mainnet:
# ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Optional: Alchemy for Base/Sepolia forking or other networks in hardhat.config.ts
# ALCHEMY_API_KEY=
